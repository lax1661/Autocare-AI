{
  "expo": {
    "name": "Autocare AI",
    "slug": "autocare-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "autocareai",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.autocareai.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
